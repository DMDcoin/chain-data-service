# HTTP server (compose.yaml overrides HOST to 0.0.0.0 inside the container)
PORT=4000
HOST=127.0.0.1
NODE_ENV=production

# PostgreSQL connection, using the least-privilege API role.
# The values below match a database container named "db" on the network joined
# via compose.db-network.yaml. When running on the host, point them at the
# published port instead, e.g. DMD_DB_API_HOST=127.0.0.1 and DMD_DB_API_PORT=5433.
DMD_DB_API_HOST=db
DMD_DB_API_PORT=5432
DMD_DB_API_NAME=postgres
DMD_DB_API_USER=diamond_api
DMD_DB_API_PASS=change-me-to-a-strong-password

# Redis used for rate limiting (falls back to in-memory counters when unreachable)
REDIS_URL=redis://redis:6379

# JSON-RPC endpoint used by the /supply endpoints
RPC_URL=https://rpc.bit.diamonds

# Per-IP request limits
PUBLIC_RATE_LIMIT_PER_MINUTE=30
AUTH_IP_RATE_LIMIT_PER_MINUTE=300
